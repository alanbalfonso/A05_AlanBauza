<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".fragmentoCheckBox">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fragmento del CheckBox"
        android:textSize="30sp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control que permite seleccionar múltiples opciones independientes. Se puede marcar o desmarcar individualmente."
        android:gravity="center"
        android:textSize="20sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejemplo: Selecciona tus intereses"
        android:gravity="center"
        android:textSize="15sp"
        android:layout_marginBottom="32dp"/>

    <!-- Título del ejemplo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Qué te gusta hacer?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp"/>

    <!-- CheckBoxes de intereses -->
    <CheckBox
        android:id="@+id/cbDeportes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deportes"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbMusica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Música"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbLectura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lectura"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbCocinar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cocinar"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbViajar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Viajar"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnSeleccionarTodos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar Todos"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDeseleccionarTodos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deseleccionar Todos"
            android:textSize="14sp"
            android:backgroundTint="@android:color/holo_orange_light"/>
    </LinearLayout>

</LinearLayout>
