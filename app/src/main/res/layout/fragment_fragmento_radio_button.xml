<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragmentoRadioButton">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fragmento del RadioButton"
        android:textSize="30sp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/black" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control que permite seleccionar una sola opción de un grupo de opciones mutuamente excluyentes."
        android:gravity="center"
        android:textSize="20sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejemplo de uso: Selección de género, tipo de pago, nivel de dificultad"
        android:gravity="center"
        android:textSize="15sp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona tu banda favorita:"
        android:layout_gravity="center"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"/>

    <RadioGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="20dp">
        <RadioButton
            android:id="@+id/radioButtonOpcion1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Metallica"
            android:textSize="20sp"/>
        <RadioButton
            android:id="@+id/radioButtonOpcion2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iron Maiden"
            android:textSize="20sp"/>
        <RadioButton
            android:id="@+id/radioButtonOpcion3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Megadeth"
            android:textSize="20sp"/>
    </RadioGroup>


</LinearLayout>
